      <bpmn:outgoing>Flow_1hzb3wt</bpmn:outgoing>
      <bpmn:script>def skipTask = execution.getVariable("failServiceTask")

println "Value of skipTask is " + skipTask

if(skipTask == true) {
println "skipTask was true"
  throw new RuntimeException("Exception abc")
} else {
println "skipTask was false"
return
}</bpmn:script>
