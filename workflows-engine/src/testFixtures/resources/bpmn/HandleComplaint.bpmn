<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_1pcau80" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.4.0">
  <bpmn:collaboration id="Collaboration_1ojibpy">
    <bpmn:participant id="Participant_1vu0y13" name="Insurance" processRef="HandleComplaint" />
  </bpmn:collaboration>
  <bpmn:process id="HandleComplaint" name="Handle Complaint" isExecutable="true">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="documentName" value="HandleComplaint" />
        <camunda:property name="documentModelName" value="HandleComplaint" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_0cxfboi">
      <bpmn:lane id="Lane_1obyekr" name="Front office">
        <bpmn:flowNodeRef>ComplaintFiled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_01ds0dm" name="Complaint department">
        <bpmn:flowNodeRef>ReviewComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1ua9kwu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ComplaintRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ComplaintHandledSuccessfully</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Respond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1jg7slv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DecidePriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1gogbik</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="ReviewComplaint" name="Review complaint">
      <bpmn:incoming>SequenceFlow_19yk8gn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1bp09t0</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1ua9kwu">
      <bpmn:incoming>SequenceFlow_1bp09t0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1uhg30f</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1mob724</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ComplaintRejected">
      <bpmn:incoming>SequenceFlow_1mob724</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ComplaintFiled" name="Complaint was filed">
      <bpmn:outgoing>SequenceFlow_19yk8gn</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="ComplaintHandledSuccessfully" name="Complaint was handled successfully">
      <bpmn:incoming>SequenceFlow_17clgl1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Analyze" name="Analyze root cause of the complaint" camunda:formKey="AnalyzeRootCause">
      <bpmn:incoming>SequenceFlow_1iczn1r</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0yrzh9k</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Respond" name="Respond to complaint" camunda:formKey="RespondToComplaint">
      <bpmn:incoming>SequenceFlow_040b0ei</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05fhk6f</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ExclusiveGateway_1jg7slv">
      <bpmn:incoming>SequenceFlow_1y7w0kn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1iczn1r</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_040b0ei</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="DecidePriority" name="Decide on priority" camunda:resultVariable="priority" camunda:decisionRef="decidePriority" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">HandleComplaint.complaint.priority = priority</camunda:script>
        </camunda:executionListener>
        <camunda:inputOutput>
          <camunda:inputParameter name="topic">${HandleComplaint.complaint.topic}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_15wv8n1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1y7w0kn</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="SendConfirmation" name="Send confirmation email" camunda:delegateExpression="${sendEmailDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="emailAddress">john@mgm.com</camunda:inputParameter>
          <camunda:inputParameter name="subject">Complaint accepted</camunda:inputParameter>
          <camunda:inputParameter name="message">
            <camunda:script scriptFormat="freemarker">Dear complainant,

Your complaint has been accepted.</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_1uhg30f</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15wv8n1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ExclusiveGateway_1gogbik">
      <bpmn:incoming>SequenceFlow_05fhk6f</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_0yrzh9k</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17clgl1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="SequenceFlow_15wv8n1" sourceRef="SendConfirmation" targetRef="DecidePriority" />
    <bpmn:sequenceFlow id="SequenceFlow_1y7w0kn" sourceRef="DecidePriority" targetRef="ExclusiveGateway_1jg7slv" />
    <bpmn:sequenceFlow id="SequenceFlow_040b0ei" sourceRef="ExclusiveGateway_1jg7slv" targetRef="Respond" />
    <bpmn:sequenceFlow id="SequenceFlow_1iczn1r" sourceRef="ExclusiveGateway_1jg7slv" targetRef="Analyze" />
    <bpmn:sequenceFlow id="SequenceFlow_0yrzh9k" sourceRef="Analyze" targetRef="ExclusiveGateway_1gogbik" />
    <bpmn:sequenceFlow id="SequenceFlow_05fhk6f" sourceRef="Respond" targetRef="ExclusiveGateway_1gogbik" />
    <bpmn:sequenceFlow id="SequenceFlow_17clgl1" sourceRef="ExclusiveGateway_1gogbik" targetRef="ComplaintHandledSuccessfully" />
    <bpmn:sequenceFlow id="SequenceFlow_19yk8gn" sourceRef="ComplaintFiled" targetRef="ReviewComplaint" />
    <bpmn:sequenceFlow id="SequenceFlow_1bp09t0" sourceRef="ReviewComplaint" targetRef="ExclusiveGateway_1ua9kwu" />
    <bpmn:sequenceFlow id="SequenceFlow_1uhg30f" name="Complaint accepted" sourceRef="ExclusiveGateway_1ua9kwu" targetRef="SendConfirmation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${HandleComplaint.complaint.isValidComplaint}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_1mob724" name="Complaint rejected" sourceRef="ExclusiveGateway_1ua9kwu" targetRef="ComplaintRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not HandleComplaint.complaint.isValidComplaint}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
