{
    "name": "@com.mgmtp.a12.workflows/workflows-codemod",
    "version": "13.1.2",
    "license": "(EUPL-1.2 OR LicenseRef-commercial)",
    "description": "Supports migration for A12 Workflows frontend modules with Codemod/Hypermod",
    "dependencies": {
        "jscodeshift": "^17.3.0",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "@com.mgmtp.a12.devtools/codemod": "^2.2.2",
        "@com.mgmtp.a12.devtools/build-tools": "^1.1.2",
        "@com.mgmtp.a12.devtools/eslint-config": "^3.1.2",
        "@com.mgmtp.a12.devtools/prettier-config": "^1.1.1",
        "@cyclonedx/cyclonedx-npm": "^4.0.1",
        "@hypermod/utils": "^0.6.0",
        "@swc/core": "^1.11.16",
        "@vitest/coverage-v8": "^3.0.0",
        "@types/jscodeshift": "^17.3.0",
        "@types/yargs": "^17.0.28",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-notice": "^1.0.0",
        "jscodeshift": "^17.3.0",
        "mkdirp": "^3.0.1",
        "npm-run-all": "4.1.5",
        "prettier": "^3.5.3",
        "typescript": "6.0.2"
    },
    "scripts": {
        "clean": "npm cache verify && rimraf ./target ./lib",
        "compile": "npm-run-all --aggregate-output --continue-on-error --parallel compile:**",
        "compile:prettier": "prettier --check src",
        "compile:lint": "mkdirp target && npm run lint -- -o ./target/LINT-workflows-codemod.xml",
        "compile:typescript": "tsc -p tsconfig.json",
        "test": "npm run test:all",
        "test:unit": "vitest run unit --passWithNoTests",
        "test:int": "vitest run int --passWithNoTests",
        "test:all": "vitest run --passWithNoTests",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write src"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "lib/",
        "bin/",
        "src/",
        "cyclonedx.json",
        "!**/tests/",
        "LICENSE",
        "NOTICE",
        "THIRD_PARTY_NOTICES",
        "licenses"
    ],
    "bin": {
        "workflows-codemod": "./bin/workflows-codemod"
    }
}
