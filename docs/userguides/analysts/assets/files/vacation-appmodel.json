{
  "header": {
    "id": "vacation-appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ],
    "annotations": [
      {
        "name": "roles",
        "value": "admin"
      }
    ],
    "modelReferences": []
  },
  "content": {
    "modules": [
      {
        "name": "VacationModule",
        "menu": {
          "name": "Vacation",
          "label": [
            {
              "locale": "en",
              "text": "Vacation"
            },
            {
              "locale": "de",
              "text": "Urlaub"
            }
          ],
          "initialActivity": {
            "descriptor": {
              "model": "Vacation_DM",
              "view": "TaskList"
            }
          }
        },
        "flows": [
          {
            "name": "TaskFlow",
            "scenes": [
              {
                "name": "VacationOverview",
