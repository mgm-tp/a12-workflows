                "matchConditions": [
                  {
                    "key": "model",
                    "mustEqual": "Vacation_DM"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "layout": {
                        "name": "MasterDetail"
                      },
                      "type": "REGION_CLEAR"
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "OverviewEngine",
                      "models": [
                        {
                          "modelType": "overview",
                          "name": "Vacation_OM"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "initialActivity": {
      "descriptor": {
        "page": "welcome"
      }
    }
  }
