    <bpmn:userTask id="UserTaskCreatingDocument" name="Submit request" camunda:modelerTemplate="userTaskNewDoc" camunda:modelerTemplateVersion="1" camunda:formKey="someFormKey">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="myRequestDocRef">${newDocRef}</camunda:outputParameter>
