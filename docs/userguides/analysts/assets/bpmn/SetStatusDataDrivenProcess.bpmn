    <bpmn:textAnnotation id="TextAnnotation_11x273b">
      <bpmn:text>Let's assume the document has the annotated fields approval and cost</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_17ximui">
      <bpmn:text>These events can be thrown whenever the status needs to be changed to trigger the other pool</bpmn:text>
