        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">execution.getProcessEngineServices().getRuntimeService().createMessageCorrelation(messageName).processInstanceBusinessKey(businessKey).setVariables(allVariables).correlate()</camunda:script>
