      <bpmn:outgoing>Flow_127em9y</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="SetStatusDelegate" name="SetStatusDelegate" camunda:modelerTemplate="setStatusDelegateTemplate" camunda:modelerTemplateVersion="1" camunda:delegateExpression="${setStatusDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="newValue">${statusnew}</camunda:inputParameter>
          <camunda:inputParameter name="pathToField">/status/status</camunda:inputParameter>
          <camunda:inputParameter name="repetitions">1,1</camunda:inputParameter>
          <camunda:inputParameter name="documentReference">${StatusDocRef}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_127em9y</bpmn:incoming>
      <bpmn:outgoing>Flow_1alw8s5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask2" name="View new status" camunda:modelerTemplate="userTaskWithInputDoc" camunda:modelerTemplateVersion="1" camunda:formKey="someFormKey">
