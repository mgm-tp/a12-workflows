    <bpmn:serviceTask id="ServiceTask_0n4e76n" name="Send hotel confirmation email" camunda:delegateExpression="#{sendEmailDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="emailAddress">#{DomainBusinessTripWF.BusinessTrip.Email}</camunda:inputParameter>
          <camunda:inputParameter name="subject">Business Trip - Hotel Confirmation</camunda:inputParameter>
          <camunda:inputParameter name="message">
            <camunda:script scriptFormat="FreeMarker">&lt;#setting locale="de_DE"&gt;&lt;#t&gt;
&lt;#t&gt;
Dear ${DomainBusinessTripWF.BusinessTrip.Employee},

Your Business Trip to your Business Trip to ${DomainBusinessTripWF.BusinessTrip.Destination} has been approved by ${DomainBusinessTripWF.BusinessTrip.Approver} and this is your hotel confirmation.

&lt;#if DomainBusinessTripWF.BusinessTrip.HotelName??&gt;
Hotel Name: ${DomainBusinessTripWF.BusinessTrip.HotelName}
&lt;/#if&gt;

&lt;#if DomainBusinessTripWF.BusinessTrip.HotelAddress??&gt;
Hotel Address: ${DomainBusinessTripWF.BusinessTrip.HotelAddress}
&lt;/#if&gt;

Best regards,
Josef on behalf of FBO team</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_1c6rx68</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1hw00on</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1lxjika" name="BUSINESS TRIP REJECTED&#10;&#10;">
      <bpmn:incoming>SequenceFlow_0e9fjip</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask_07id89d" name="Send business trip rejected email" camunda:delegateExpression="#{sendEmailDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="emailAddress">#{DomainBusinessTripWF.BusinessTrip.Email}</camunda:inputParameter>
          <camunda:inputParameter name="subject">Business trip has been rejected</camunda:inputParameter>
          <camunda:inputParameter name="message">
            <camunda:script scriptFormat="FreeMarker">&lt;#setting locale="de_DE"&gt;&lt;#t&gt;
&lt;#t&gt;
Dear ${DomainBusinessTripWF.BusinessTrip.Employee},

Your Business Trip to your Business Trip to ${DomainBusinessTripWF.BusinessTrip.Destination} has been rejected by ${DomainBusinessTripWF.BusinessTrip.Approver}.

The reason for rejecting is: ${DomainBusinessTripWF.BusinessTrip.ApprovingNote}

I am so sorry.

Best regards,
Josef on behalf of FBO team</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_1m1v50g</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1pxk7n7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_1npgdg2" name="Export rejected business trip document" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:delegateExpression="#{exportDocumentDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="documentName">DomainBusinessTripWF</camunda:inputParameter>
          <camunda:inputParameter name="documentModelName">DomainBusinessTripWF</camunda:inputParameter>
          <camunda:outputParameter name="documentId">${latestExportedDocumentId}</camunda:outputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">def id = execution.getVariable("latestExportedDocumentId")
println("Created new document with ID ${id}")
execution.setVariable("businessTripId", id.toString());</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_1pxk7n7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11hnadx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_0qw4gvv" name="Send transportation confirmation email" camunda:delegateExpression="#{sendEmailDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="emailAddress">#{DomainBusinessTripWF.BusinessTrip.Email}</camunda:inputParameter>
          <camunda:inputParameter name="subject">Business Trip - Tranportation Confirmation</camunda:inputParameter>
          <camunda:inputParameter name="message">
            <camunda:script scriptFormat="FreeMarker">&lt;#setting locale="de_DE"&gt;&lt;#t&gt;
&lt;#t&gt;
Dear ${DomainBusinessTripWF.BusinessTrip.Employee},

Your Business Trip to your Business Trip to ${DomainBusinessTripWF.BusinessTrip.Destination} has been approved by ${DomainBusinessTripWF.BusinessTrip.Approver} and this is your transportation confirmation.

Selected type of transportation: ${DomainBusinessTripWF.BusinessTrip.Transportation}
&lt;#if DomainBusinessTripWF.BusinessTrip.TransportationDetails??&gt;
${DomainBusinessTripWF.BusinessTrip.TransportationDetails}
&lt;/#if&gt;

Best regards,
Josef on behalf of FBO team</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_1mea9ou</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0d5zw7a</bpmn:outgoing>
    </bpmn:serviceTask>
