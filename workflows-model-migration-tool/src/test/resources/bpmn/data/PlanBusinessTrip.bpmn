    <bpmn:serviceTask id="ServiceTask_0o3l5wh" name="Export realized business trip document" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:delegateExpression="#{exportDocumentDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="documentName">DomainBusinessTripWF</camunda:inputParameter>
          <camunda:inputParameter name="documentModelName">DomainBusinessTripWF</camunda:inputParameter>
          <camunda:outputParameter name="documentId">${latestExportedDocumentId}</camunda:outputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">def id = execution.getVariable("latestExportedDocumentId")
println("Created new document with ID ${id}")
execution.setVariable("businessTripId", id.toString());</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1mrux1m</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0klt81t</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_1gv5x6k" name="Trigger expense process" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_1l89s7o</bpmn:incoming>
      <bpmn:outgoing>Flow_1r7hh77</bpmn:outgoing>
      <bpmn:script>def document = execution.getVariable("DomainBusinessTripWF")
def updateId = execution.getVariable("businessTripId")

Map&lt;String, Object&gt; variables = new HashMap&lt;String,Object&gt;();

variables.put("DomainBusinessTripWF", [BusinessTrip: document.BusinessTrip, id: updateId.toString()]);

def initiator = execution.getVariable("initiator")
variables.put("initiator", initiator);

execution.getProcessEngineServices().getRuntimeService().startProcessInstanceByKey("FillTravelExpensesProcess", variables)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1l89s7o" sourceRef="ServiceTask_0wivb9i" targetRef="Activity_1gv5x6k" />
    <bpmn:sequenceFlow id="Flow_1r7hh77" sourceRef="Activity_1gv5x6k" targetRef="EndEvent_0wi25dd" />
    <bpmn:startEvent id="StartEvent_1jgb9af" name="PLAN BUSINESS TRIP">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">def document = execution.getVariable("DomainPerson_DM")
def processData = [BusinessTrip: [Employee : document.Person.PersonalData.FirstName + " " + document.Person.PersonalData.LastName, Email : document.Person.PersonalData.Email]]
execution.setVariable("DomainBusinessTripWF", processData)</camunda:script>
        </camunda:executionListener>
        <camunda:properties>
          <camunda:property name="inputDocumentModel" value="DomainPerson_DM" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>SequenceFlow_1gfkrgi</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_1elozv6" name="Pay deposit" camunda:formKey="PayDeposit">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">def document = execution.getVariable("DomainBusinessTripWF")
document.BusinessTrip.Status = "Planned"</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_08ztesu</bpmn:incoming>
      <bpmn:outgoing>Flow_1mrux1m</bpmn:outgoing>
    </bpmn:userTask>
